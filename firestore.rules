rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validUserProfile(userId) {
      return request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'phoneNumber',
          'birthDate',
          'photoUrl',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'name',
          'email',
          'phoneNumber',
          'birthDate',
          'photoUrl',
          'createdAt'
        ])
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.birthDate is string
        && request.resource.data.photoUrl is string
        && request.resource.data.createdAt is number;
    }

    function validDirectConversation(conversationId) {
      let data = request.resource.data;
      let first = data.participants[0];
      let second = data.participants[1];
      return data.keys().hasOnly(['id', 'type', 'participants', 'createdAt'])
        && data.keys().hasAll(['id', 'type', 'participants', 'createdAt'])
        && data.id == conversationId
        && data.type == 'direct'
        && data.participants is list
        && data.participants.size() == 2
        && first is string
        && second is string
        && first < second
        && conversationId == first + '_' + second
        && request.auth.uid in data.participants
        && exists(/databases/$(database)/documents/publicProfiles/$(first))
        && exists(/databases/$(database)/documents/publicProfiles/$(second))
        && data.createdAt is number;
    }

    function validGroup(groupId) {
      let data = request.resource.data;
      return data.keys().hasOnly([
          'id',
          'name',
          'photoUrl',
          'ownerId',
          'memberIds',
          'memberLimit',
          'notificationPolicy',
          'createdAt',
          'updatedAt',
          'membershipVersion'
        ])
        && data.keys().hasAll([
          'id',
          'name',
          'photoUrl',
          'ownerId',
          'memberIds',
          'memberLimit',
          'notificationPolicy',
          'createdAt',
          'updatedAt'
        ])
        && data.id == groupId
        && data.name is string
        && data.name.size() >= 3
        && data.name.size() <= 50
        && data.photoUrl is string
        && data.ownerId is string
        && data.memberIds is list
        && data.memberIds.size() >= 2
        && data.memberIds.size() <= data.memberLimit
        && data.memberIds.toSet().size() == data.memberIds.size()
        && data.ownerId in data.memberIds
        && data.memberLimit is int
        && data.memberLimit >= 2
        && data.memberLimit <= 100
        && data.notificationPolicy in [
          'all_group_messages',
          'mentioned_members',
          'direct_messages_only',
          'disabled'
        ]
        && (!data.keys().hasAny(['membershipVersion'])
          || (data.membershipVersion is int && data.membershipVersion >= 0))
        && data.createdAt is number
        && data.updatedAt is number;
    }

    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && validUserProfile(userId);
      allow update: if signedIn()
        && request.auth.uid == userId
        && validUserProfile(userId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /publicProfiles/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['uid', 'name', 'photoUrl'])
        && request.resource.data.keys().hasAll(['uid', 'name', 'photoUrl'])
        && request.resource.data.uid == userId
        && request.resource.data.name is string
        && request.resource.data.photoUrl is string
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(userId)).data.name
        && request.resource.data.photoUrl == get(/databases/$(database)/documents/users/$(userId)).data.photoUrl;
      allow delete: if false;
    }

    match /directConversations/{conversationId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn()
        && validDirectConversation(conversationId);
      allow update, delete: if false;
    }

    match /groups/{groupId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && validGroup(groupId);
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name',
          'photoUrl',
          'memberLimit',
          'notificationPolicy',
          'updatedAt'
        ])
        && validGroup(groupId);
      allow delete: if false;
    }

    match /users/{userId}/devices/{deviceId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['token', 'platform', 'enabled', 'updatedAt'])
        && request.resource.data.keys().hasAll(['token', 'platform', 'enabled', 'updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.platform in ['ios', 'android']
        && request.resource.data.enabled == true
        && request.resource.data.updatedAt is number;
      allow delete: if signedIn() && request.auth.uid == userId;
    }
  }
}
